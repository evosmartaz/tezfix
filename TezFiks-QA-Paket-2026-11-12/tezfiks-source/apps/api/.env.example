# ---- TezFiks API environment (copy to .env for local development) ----
NODE_ENV=development
PORT=3000
# all = HTTP + Socket.IO + background jobs in one process; api / worker split later
ROLE=all
API_PREFIX=tezfix/api
SOCKET_PATH=/tezfix/api/socket.io
# Public origin used to build absolute links (checkout pages, invite links, file URLs)
PUBLIC_BASE_URL=http://localhost:3000
# Optional override; defaults to PUBLIC_BASE_URL + "/" + API_PREFIX
# PUBLIC_API_URL=https://evosmart.az/tezfix/api
CORS_ORIGINS=http://localhost:3100
TRUST_PROXY=loopback

DATABASE_URL=postgresql://tezfiks:tezfiks@127.0.0.1:55432/tezfiks
# Supabase later: DIRECT_URL is used by prisma migrate (direct or session pooler)
# DIRECT_URL=
REDIS_URL=redis://127.0.0.1:56379/0
REDIS_PREFIX=tz

# At least 32 random characters. openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-dev-only-secret-change-me
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_DAYS=30
# FILE_URL_SECRET= (defaults to a value derived from JWT_SECRET)

STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads

# Fast timers + demo simulator controls. Also enables the fake card provider (test checkout), OTP bypass phones and admin
# balance adjustments; without it card payments answer PAYMENTS_UNAVAILABLE and "arrived" needs a fresh position at the address.
DEMO_MODE=true
# Fake card payments without DEMO_MODE (local development only; refused when NODE_ENV=production)
# PAYMENTS_TEST_MODE=false

# Login codes: console (log only) | whatsapp_cloud | webhook (your own WhatsApp bot)
OTP_CHANNEL=console
# Returns the code in the API response. Development only; refused in production.
OTP_DEV_ECHO=true
# Fixed code for listed phones (demo devices), e.g. +994501112233,+994552223344. Demo only: the API refuses to start with
# these set while DEMO_MODE=false.
OTP_BYPASS_PHONES=
OTP_BYPASS_CODE=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=tezfiks_login
WHATSAPP_GRAPH_VERSION=v26.0
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
OTP_WEBHOOK_URL=
OTP_WEBHOOK_SECRET=

GOOGLE_MAPS_SERVER_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# log | expo | fcm
PUSH_PROVIDER=log
# Path to (or inline JSON of) a Firebase service account, for PUSH_PROVIDER=fcm
FCM_SERVICE_ACCOUNT=
EXPO_ACCESS_TOKEN=

# First TezFiks admin, created by the seed when no admin exists
ADMIN_BOOTSTRAP_EMAIL=admin@tezfiks.az
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe-TezFiks-2026
ADMIN_BOOTSTRAP_NAME=TezFiks Admin

LOG_LEVEL=info
CONTRACT_VALIDATE_RESPONSES=true
# bullmq (real timers) | manual (tests drive timers explicitly)
JOBS_MODE=bullmq
RECONCILER_INTERVAL_SEC=30
# A repair task running longer than this is abandoned for the tick (and skipped until it settles)
RECONCILER_TASK_TIMEOUT_SEC=120
SUPPORT_PHONE=
APP_SCHEME_CUSTOMER=tezfiks
APP_SCHEME_PRO=tezfiksusta
