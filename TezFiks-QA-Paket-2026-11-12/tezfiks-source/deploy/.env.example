# TezFiks production environment. Copy to deploy/.env (never commit it) and fill in every value marked REQUIRED.
# docker compose reads this file for the containers and for ${...} in deploy/docker-compose.yml.

# --- Databases (REQUIRED passwords) -------------------------------------------------------------
POSTGRES_USER=tezfiks
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=tezfiks
REDIS_PASSWORD=change-me-long-random
# Host ports (bound to 127.0.0.1 only). deploy/nginx/tezfiks.conf proxies to 3300 / 3310 (3000 is taken on evosmart.az).
POSTGRES_PORT=55432
API_PORT=3300
PANEL_PORT=3310

# --- Public URLs -------------------------------------------------------------------------------
# The site root. The API then lives at ${PUBLIC_BASE_URL}/tezfix/api and the panels at ${PUBLIC_BASE_URL}/tezfix.
PUBLIC_BASE_URL=https://evosmart.az
# Browser origins allowed to call the API (the panel). Comma separated.
CORS_ORIGINS=https://evosmart.az
# Which hops may set X-Forwarded-For. nginx on the host reaches the containers through the Docker bridge,
# and the panel calls the API over the Docker network, so trust loopback and private ranges.
TRUST_PROXY=loopback, uniquelocal

# --- Secrets (REQUIRED) ------------------------------------------------------------------------
# At least 32 random characters, e.g.: openssl rand -hex 32
JWT_SECRET=
# Optional separate secret for signed file URLs (defaults to one derived from JWT_SECRET).
FILE_URL_SECRET=

# --- First admin (created by the migrate service if it does not exist) ------------------------
ADMIN_BOOTSTRAP_EMAIL=admin@evosmart.az
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=TezFiks Admin

# --- Login codes (WhatsApp; there is no SMS provider) -----------------------------------------
# console = codes are only logged (demo); whatsapp_cloud = Meta WhatsApp Cloud API authentication template;
# webhook = POST to your own WhatsApp bot (signed with OTP_WEBHOOK_SECRET).
OTP_CHANNEL=console
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=tezfiks_login
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
OTP_WEBHOOK_URL=
OTP_WEBHOOK_SECRET=
# Demo/testing only: these phones (comma separated, +994...) always accept OTP_BYPASS_CODE (6 digits).
OTP_BYPASS_PHONES=
OTP_BYPASS_CODE=
# Never true in production (the API refuses to start).
OTP_DEV_ECHO=false

# --- Demo ------------------------------------------------------------------------------------
# true enables the admin "Demo" page (bot handymen, simulator) and test-mode extras.
DEMO_MODE=true

# --- Integrations (optional; the app falls back gracefully without them) -----------------------
# Google Maps server key (Routes, Geocoding, Places), IP-restricted to this server.
GOOGLE_MAPS_SERVER_KEY=
# Browser key for the panel maps (HTTP-referrer restricted). Empty = OpenStreetMap tiles.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
# Mapbox PUBLIC token (pk.*, URL-restricted to the panel domain) for the panel map tiles; wins over the Google key.
# Baked in at image build time. A secret sk.* token fails the build. Empty = Google key or OpenStreetMap tiles.
NEXT_PUBLIC_MAPBOX_TOKEN=
# Optional Mapbox style ("owner/style", e.g. a Mapbox Studio style). Empty = mapbox/streets-v12.
NEXT_PUBLIC_MAPBOX_STYLE=
# Panel Socket.IO origin. Empty = same origin (correct behind nginx).
NEXT_PUBLIC_SOCKET_URL=
# Claude (photo -> category). Empty = the feature is hidden.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Push: log (no push), expo (Expo push service) or fcm (Firebase; paste the service-account JSON on one line).
PUSH_PROVIDER=log
EXPO_ACCESS_TOKEN=
FCM_SERVICE_ACCOUNT=

# --- Files ---------------------------------------------------------------------------------
# local = Docker volume "uploads"; s3 = any S3-compatible store (Supabase Storage, Cloudflare R2, MinIO).
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Misc ----------------------------------------------------------------------------------
LOG_LEVEL=info
SUPPORT_PHONE=
