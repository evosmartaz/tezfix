{
  "name": "@tezfiks/api",
  "version": "0.1.0",
  "private": true,
  "description": "TezFiks backend: REST API, Socket.IO realtime and background jobs (NestJS)",
  "main": "dist/src/main.js",
  "scripts": {
    "build": "npm run prisma:generate && tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "dev": "npm run prisma:generate && node scripts/dev.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed/index.ts",
    "seed:demo": "tsx prisma/seed/demo.ts",
    "seed:qa-admin": "tsx prisma/seed/qa-admin.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@aws-sdk/client-s3": "3.1149.0",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/platform-socket.io": "12.2.0",
    "@nestjs/websockets": "12.2.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tezfiks/i18n": "0.1.0",
    "@tezfiks/shared": "0.1.0",
    "bullmq": "6.4.1",
    "dotenv": "18.0.9",
    "expo-server-sdk": "8.0.0",
    "firebase-admin": "14.5.0",
    "h3-js": "4.5.0",
    "heic-decode": "2.1.0",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "multer": "2.5.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "socket.io": "4.8.4",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.2.0",
    "@swc/core": "1.16.20",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "prisma": "7.10.1",
    "socket.io-client": "4.8.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  }
}
