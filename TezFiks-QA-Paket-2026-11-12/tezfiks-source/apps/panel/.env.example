# TezFiks web panel (apps/panel). Copy to .env.local for `next dev`.

# API base used server-to-server by Server Actions, Server Components, the proxy and route handlers (BFF).
API_INTERNAL_URL=http://127.0.0.1:3000/tezfix/api

# Browser Socket.IO origin (path is always /tezfix/api/socket.io). Empty = same origin as the panel (production behind nginx).
# In development the panel runs on :3100 and the API on :3000, so set it explicitly.
NEXT_PUBLIC_SOCKET_URL=http://127.0.0.1:3000

# Google Maps JavaScript API key for the browser. Empty = OpenStreetMap tiles via Leaflet.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# Session cookies get `Secure` in production. Set to false only for plain-HTTP staging.
# COOKIE_SECURE=false

# Contract validation of API responses outside production (default on). Set to false to disable.
# PANEL_VALIDATE_RESPONSES=false
