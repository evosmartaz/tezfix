{
  "name": "@tezfiks/shared",
  "version": "0.1.0",
  "private": true,
  "description": "TezFiks shared contract: enums, zod schemas, REST endpoints, socket events, business policies, formatters",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "libphonenumber-js": "1.13.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
